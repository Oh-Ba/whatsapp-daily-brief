# Copy to .env and fill in the real values. Never commit .env.

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Twilio (required) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox number by default; change to your approved sender in production.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Approved content template SID. Required for the 08:00 push to work
# outside Twilio's 24-hour window (error 63016 fallback). Optional.
TWILIO_CONTENT_SID=

# --- App ---
PORT=3580
DAILY_HOUR=8
TIMEZONE=Asia/Jerusalem
MAX_USERS=10
