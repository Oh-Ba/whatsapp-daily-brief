# Copy to .env and fill in the real values. Never commit .env.

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email / SMTP (required) ---
# Gmail: SMTP_PASS is a 16-character App Password from
# myaccount.google.com -> Security -> App passwords.
# It is NOT your Google account password. Paste it without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=abcdefghijklmnop
# Optional display name on the From line.
MAIL_FROM=The 08:00 Brief <you@gmail.com>

# --- App ---
PORT=3580
DAILY_HOUR=8
TIMEZONE=Asia/Jerusalem
MAX_USERS=10

# --- Spoken version (optional) ---
# Attaches an MP3 of the brief read aloud. Needs piper + ffmpeg on the box:
#   apt install -y ffmpeg && pip install piper-tts
# Download a male voice model, then point PIPER_MODEL at the .onnx file.
TTS_ENABLED=false
PIPER_MODEL=/opt/piper-voices/en_US-ryan-high.onnx
PIPER_BIN=piper
FFMPEG_BIN=ffmpeg
TTS_BITRATE=64k
