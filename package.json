{
  "name": "daily-brief",
  "version": "2.0.0",
  "description": "24/7 agent that emails a daily country brief (news, holidays, language lesson, geography, prices) at 08:00",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "send-now": "node src/send-now.js",
    "check-mail": "node src/check-mail.js",
    "check-voice": "node src/check-voice.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14"
  }
}
